rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function me() { return request.auth.token.email.lower(); }
    // GŁÓWNI ADMINISTRATORZY – wpisz e-maile małymi literami
    function isSuper() { return signedIn() && me() in ['lukasz.grudka@gmail.com']; }
    function company(cid) { return get(/databases/$(database)/documents/companies/$(cid)).data; }

    // Sprawdzenie w aplikacji, czy zalogowany jest administratorem
    match /meta/super { allow read: if isSuper(); }

    // Lista nazw firm do wyboru przy rejestracji (same nazwy, bez danych)
    match /directory/{cid} {
      allow read: if signedIn();
      allow write: if isSuper();
    }

    // Prośby o dostęp: użytkownik wysyła tylko w swoim imieniu, akceptuje administrator
    match /requests/{rid} {
      allow read: if signedIn() && (resource.data.email == me() || isSuper());
      allow create: if signedIn()
        && request.resource.data.email == me()
        && rid == request.resource.data.cid + '_' + me();
      allow delete: if signedIn() && (resource.data.email == me() || isSuper());
    }

    // Firmy: tworzą i zmieniają tylko administratorzy, członkowie widzą swoją firmę
    match /companies/{cid} {
      allow read: if signedIn() && (me() in resource.data.members || isSuper());
      allow create, update, delete: if isSuper();

      // Plany firmy: wyłącznie członkowie tej firmy (także administrator musi być członkiem)
      match /plans/{pid} {
        allow read, write: if signedIn() && me() in company(cid).members;
      }
    }
  }
}
